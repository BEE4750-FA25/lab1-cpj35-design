      "execution_count": null,
      "id": "22",
      "metadata": {},
      "outputs": [
        {
          "data": {
            "text/plain": [
              "square_integer (generic function with 1 method)"
            ]
          },
          "execution_count": 15,
          "metadata": {},
          "output_type": "execute_result"
        }
      ],
      "source": [
        "# insert your code here\n",
        "function square_integer(a)\n",
        "    b = Int[]\n",
        "    for i in 1:length(a)\n",
        "        push!(b, a[i]^2)\n",
        "    end\n",
        "    return b\n",
        "end"
      ]
